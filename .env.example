# Copy this file to .env.local and fill in the values.
# Get these from: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://<APPROVED_V2_SUPABASE_PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<APPROVED_V2_SUPABASE_ANON_KEY>
VITE_SUPABASE_FUNCTIONS_URL=https://<APPROVED_V2_SUPABASE_PROJECT_REF>.supabase.co/functions/v1

# Storage bucket name (already created in Supabase)
VITE_DOCS_BUCKET=secure-docs

# P2.1 read-only Client Master Preview (Admin/Manager only). Default DISABLED.
# Set to 'true' ONLY in an approved dev environment to reveal the read-only preview.
# VITE_P2_PREVIEW=false

# Client 360° Operational Workspace (Admin/Manager only). Default DISABLED (ships dark).
# Set to 'true' in an approved environment to reveal the 🧭 Client 360° launcher on the
# client detail modal. Read-first; the only writes reuse existing permission-checked flows.
# VITE_CLIENT360_UI=false
